# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# NEVER expose this key to the client bundle (no VITE_ prefix): all Gemini calls
# must be proxied server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# ACCESS CONFIGURATION (Bootstrap Vault)
#
# These values are read by src/config/accessConfig.ts. Because VITE_* variables
# are inlined into the client bundle, they are discovery/demo gating only: real
# authorization is enforced by Firebase Auth custom claims + Firestore rules.
# Leave any variable unset to disable the corresponding surface entirely.
# ---------------------------------------------------------------------------

# Dialpad sequence that opens the Master authentication challenge.
VITE_MASTER_TRIGGER_CODE=""

# Comma-separated dialpad sequence(s) that open the driver login modal.
VITE_DRIVER_TRIGGER_CODES=""

# Challenge secret required before Master/Founder privileges are granted.
VITE_FOUNDER_CHALLENGE_CODE=""

# Comma-separated Shamir share fragments accepted by the break-glass protocol
# (at least two must be provisioned; 2 distinct valid fragments unlock).
VITE_BREAKGLASS_SHARE_FRAGMENTS=""

# Demo PINs for the seeded managed credentials, formatted `id:pin,id:pin`.
# Unset in production: seeded credentials then have no PIN and cannot log in.
VITE_DEMO_CREDENTIAL_PINS=""

# Dev-only privilege escalation surfaces (debug sequence / ephemeral vault token
# / biometric shortcut). Only honored in `vite dev` builds.
VITE_ENABLE_DEV_ESCALATION="false"
VITE_DEV_DEBUG_SEQUENCE=""
VITE_DEV_VAULT_TOKEN=""
