rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC) & Custom Claims
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated() && request.auth.token.role == 'MASTER';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDriver() {
      return isAuthenticated() && request.auth.token.role == 'DRIVER';
    }

    // 1. Users Collection
    // Passengers and Drivers can read/write their own profile; Masters have administrative access.
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isMaster());
      // Users cannot escalate their own role or edit their wallet balance.
      allow create: if isMaster() || (isOwner(userId) && request.resource.data.role == 'PASSENGER');
      allow update: if isMaster() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'walletAOA', 'rating'])
      );
      allow delete: if isMaster();
    }

    // 2. Drivers Collection
    // Public/Passenger can read basic driver location and rating; Driver can update own telemetry/status; Master manages all.
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      // A driver may never grant itself verification, balance or rating changes.
      allow update: if isMaster() || (
        isAuthenticated() && request.auth.uid == driverId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['balanceAOA', 'rating', 'verified', 'role', 'commissionRate'])
      );
      allow create, delete: if isMaster();
    }

    // 3. Rides Collection
    // Passenger creates and reads their rides; Driver reads assigned rides and updates status; Master reads all.
    match /rides/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isMaster()
      );
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      // Fare and commission are computed server-side and immutable for clients.
      allow update: if isMaster() || (
        isAuthenticated() &&
        (resource.data.passengerId == request.auth.uid || resource.data.driverId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['price_aoa', 'commissionAOA', 'passengerId'])
      );
      allow delete: if isMaster();
    }

    // 4. Vehicles Collection
    // Drivers read/update their vehicle; Master verifies vehicle and manages fleet.
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      // Only Master may flip the `verified` flag on a vehicle.
      allow update: if isMaster() || (
        isAuthenticated() && resource.data.driverId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'driverId'])
      );
      allow create, delete: if isMaster();
    }

    // 5. Transactions Collection (Immutable Ledger)
    // Passenger/Driver can read their own transactions; Writes/deletes are strictly reserved for verified backend / Master.
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        isMaster()
      );
      allow write: if isMaster();
    }

    // 6. Locations Collection (Luanda Geohash Points)
    // Read-only for authenticated users; Master manages dispatch zones.
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if isMaster();
    }

    // 7. Settings Collection (Pricing, Fare Multipliers, Commission Rate)
    // Global parameters: read-only for clients, strictly editable by Master.
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isMaster();
    }
  }
}
